# Frontend pointed at the deployed backend for smoke testing.
# Public routes should work immediately. Login and owner-only routes require
# real non-local Keycloak values, which must not be committed here.

VITE_API_BASE_URL=https://tumelokonaitedev--rooms-marketplace-api-fastapi-app.modal.run
VITE_KEYCLOAK_ISSUER=https://auth.example.com/realms/marketplace
VITE_KEYCLOAK_TOKEN_URL=https://auth.example.com/realms/marketplace/protocol/openid-connect/token
VITE_KEYCLOAK_CLIENT_ID=marketplace-api
