# Runtime identity and HTTP listener
ENVIRONMENT=local
PORT=8000
APP_NAME=rooms-marketplace-api

# Comma-separated browser origins (origins only; no paths or trailing slash).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Optional, tightly scoped preview-deployment regex.
FRONTEND_PREVIEW_ORIGIN_REGEX=

# SQLAlchemy uses synchronous psycopg. Non-local deployments automatically add
# sslmode=verify-full when it is omitted. URL-encode special characters in credentials.
# For Azure PostgreSQL, append:
# &sslrootcert=/etc/ssl/certs/azure-postgresql-roots.pem
DATABASE_URL=postgresql+psycopg://marketplace_user:replace_me@localhost:5432/marketplace_db
# Optional direct/session-pooler URL used only by the explicit Alembic job.
MIGRATION_DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=10
DATABASE_POOL_RECYCLE=1800
DATABASE_CONNECT_TIMEOUT=5

# Clerk server configuration
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_JWT_ISSUER=
CLERK_JWKS_URL=
CLERK_JWT_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://localhost:3000
CLERK_WEBHOOK_SECRET=whsec_replace_me

# S3-compatible durable object storage (MinIO, Supabase Storage, Azure S3 gateway, etc.)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=listing-images
OBJECT_STORAGE_ACCESS_KEY=replace_me
OBJECT_STORAGE_SECRET_KEY=replace_me
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_PUBLIC_URL=http://localhost:9000
MAX_IMAGE_UPLOAD_MB=5

# Local docker-compose dependency settings; not used by the production API image.
POSTGRES_DB=marketplace_db
POSTGRES_USER=marketplace_user
POSTGRES_PASSWORD=replace_me
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
DOCKER_DATABASE_URL=postgresql+psycopg://marketplace_user:replace_me@postgres:5432/marketplace_db
DOCKER_MINIO_ENDPOINT=http://minio:9000
