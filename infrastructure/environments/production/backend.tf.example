# Copy to backend.tf and fill in an existing bootstrap storage account.
# Never commit backend credentials or access keys.
terraform {
  backend "azurerm" {
    resource_group_name  = "rg-rooms-terraform-state"
    storage_account_name = "roomsprodterraformstate"
    container_name       = "tfstate"
    key                  = "rooms-backend.production.tfstate"
    use_azuread_auth     = true
  }
}

