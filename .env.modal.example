# Modal deployment values for the production backend.
# Copy to `.env.modal` locally if you want a separate file to track the values
# you will later store in the Modal Secret.

APP_ENV=production
FRONTEND_ORIGIN=https://rooms.example.com

# Supabase Postgres
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase Storage S3 compatibility
# Copy these from Storage -> S3 in the Supabase dashboard.
MINIO_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
MINIO_REGION=<project-region>
MINIO_ACCESS_KEY=<s3-access-key-id>
MINIO_SECRET_KEY=<s3-secret-access-key>
MINIO_BUCKET_LISTING_IMAGES=rooms_marketplace

# Public URL base used when the API returns image URLs.
# The bucket must be public if the frontend should load these URLs directly.
MINIO_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public

MAX_IMAGE_UPLOAD_MB=5

# Clerk server credentials
CLERK_SECRET_KEY=sk_live_replace_me
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me
CLERK_AUTHORIZED_PARTIES=https://rooms.example.com
