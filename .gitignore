# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv/
backend/.venv/

# Local environment files
.env
.env.modal
backend/.env
backend/.env.*
!backend/.env.example
!backend/.env.server-test.example

# Test and coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Terraform working data, inputs, plans, and state
**/.terraform/
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
*.tfplan
terraform.tfstate
terraform.tfstate.*
!**/terraform.tfvars.example

# Database exports can contain production data and credentials
*.backup
*.backup.gz
*.dump
*.sql.gz
