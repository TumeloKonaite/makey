APP_NAME=rooms-marketplace-api
APP_ENV=local
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Host-run backend values
DATABASE_URL=postgresql+psycopg://marketplace_user:marketplace_password@localhost:5432/marketplace_db
POSTGRES_DB=marketplace_db
POSTGRES_USER=marketplace_user
POSTGRES_PASSWORD=marketplace_password
POSTGRES_PORT=5432

MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_LISTING_IMAGES=listing-images
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAX_IMAGE_UPLOAD_MB=5

# Keycloak issuer and local client/authorized-party settings
KEYCLOAK_ISSUER=http://localhost:8080/realms/marketplace
KEYCLOAK_AUTHORIZED_PARTY=marketplace-api
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/marketplace/protocol/openid-connect/certs
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080

# Optional overrides for the API container when using `docker compose up --build`.
DOCKER_DATABASE_URL=postgresql+psycopg://marketplace_user:marketplace_password@postgres:5432/marketplace_db
DOCKER_MINIO_ENDPOINT=http://minio:9000
DOCKER_KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/marketplace/protocol/openid-connect/certs
