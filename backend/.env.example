APP_NAME=rooms-marketplace-api
APP_ENV=local
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_PREVIEW_ORIGIN_REGEX=

# For Modal or any non-local deployment, keep the same variable names below
# but replace localhost and Docker-only hostnames with externally reachable URLs.

# Host-run backend values
DATABASE_URL=postgresql+psycopg://marketplace_user:marketplace_password@localhost:5432/marketplace_db
MIGRATION_DATABASE_URL=
POSTGRES_DB=marketplace_db
POSTGRES_USER=marketplace_user
POSTGRES_PASSWORD=marketplace_password
POSTGRES_PORT=5432

MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Optional aliases for production S3-compatible services:
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
MINIO_BUCKET_LISTING_IMAGES=listing-images
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAX_IMAGE_UPLOAD_MB=5

# Clerk server credentials. Never expose these to the browser.
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://localhost:3000

# Optional overrides for the API container when using `docker compose up --build`.
DOCKER_DATABASE_URL=postgresql+psycopg://marketplace_user:marketplace_password@postgres:5432/marketplace_db
DOCKER_MINIO_ENDPOINT=http://minio:9000
